# Keep KiCad and text sources LF so diffs stay clean across machines
*.kicad_pro   text eol=lf
*.kicad_sch   text eol=lf
*.kicad_pcb   text eol=lf
*.kicad_sym   text eol=lf
*.kicad_dru   text eol=lf
sym-lib-table text eol=lf
fp-lib-table  text eol=lf
*.py          text eol=lf
*.md          text eol=lf
*.json        text eol=lf
*.xml         text eol=lf
*.svg         text eol=lf

# Treat SVG previews as binary for diffing (large machine-generated)
verification/*.svg -diff
